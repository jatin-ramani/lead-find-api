# ==========================================================================
# Keep the build context small and, above all, free of secrets.
#
# The runtime stage COPYs only named paths, so this is the second of two
# locks. It matters anyway: everything here is uploaded to the daemon on
# every build, and anything in the context can be read by any build stage.
# ==========================================================================

# --- secrets --------------------------------------------------------------
.env
.env.*
!.env.example
*.pem
*.key
credentials.json
service-account*.json

# --- local databases ------------------------------------------------------
# A developer's SQLite file would otherwise be baked in and, worse, silently
# used by a container whose DATABASE_URL was misconfigured.
*.db
*.db-journal
*.db-wal
*.db-shm
*.sqlite
*.sqlite3
*.bak

# --- virtualenv -----------------------------------------------------------
# Host-built, platform-specific, and hundreds of megabytes. The image builds
# its own at /opt/venv.
venv/
.venv/
env/
ENV/

# --- python artefacts -----------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.so
build/
dist/
*.egg-info/
.eggs/

# --- tooling --------------------------------------------------------------
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
.idea/
.vscode/
*.swp
.DS_Store

# --- vcs and docs ---------------------------------------------------------
.git/
.gitignore
.gitattributes
README.md
docker-compose.yml
docker-compose.*.yml
Dockerfile
.dockerignore

# NOTE: tests/ and requirements-dev.txt are deliberately NOT ignored — the
# `test` build stage needs them. They never reach the runtime stage, which
# copies only the source directories it names.
