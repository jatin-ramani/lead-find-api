# ==========================================================================
# Lead Finder — backend configuration
#
# Copy to `.env` and fill in the values you need:
#
#     cp .env.example .env
#
# `.env` is gitignored and must never be committed — it holds live secrets.
# Every setting below has a default that reproduces current behaviour, so a
# developer only needs GEOAPIFY_API_KEY to get started.
#
# Real environment variables always win over this file, which is how
# containers and CI should supply configuration.
# ==========================================================================


# --------------------------------------------------------------------------
# Environment
# --------------------------------------------------------------------------
# development | testing | production
#
# `production` additionally enforces:
#   - GEOAPIFY_API_KEY must be set
#   - DATABASE_URL must not be SQLite
#   - CORS_ORIGINS must not contain "*"
#   - /docs and /redoc are hidden unless DEBUG=true
ENVIRONMENT=development

# Verbose errors and interactive docs. Never enable in production.
DEBUG=false


# --------------------------------------------------------------------------
# Secrets
# --------------------------------------------------------------------------
# Geoapify Places + Geocoding key — https://myprojects.geoapify.com/
# Required when ENVIRONMENT=production. Without it, scanning fails.
GEOAPIFY_API_KEY=your-geoapify-api-key-here


# --------------------------------------------------------------------------
# Database
# --------------------------------------------------------------------------
# Defaults to the bundled SQLite file (absolute path, resolved from the
# backend directory). Uncomment the PostgreSQL line for anything real.
#
# DATABASE_URL=sqlite:///./database/leadfinder.db
# DATABASE_URL=postgresql+psycopg://user:password@localhost:5432/leadfinder

# Log every SQL statement. Noisy; useful when debugging a query.
DATABASE_ECHO=false

# Seconds before a pooled connection is recycled (non-SQLite only).
DATABASE_POOL_RECYCLE_SECONDS=1800


# --------------------------------------------------------------------------
# CORS
# --------------------------------------------------------------------------
# Comma-separated, or a JSON array. Must list the frontend's exact origin —
# "*" is rejected in production.
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
CORS_ALLOW_CREDENTIALS=true


# --------------------------------------------------------------------------
# Geoapify tuning
# --------------------------------------------------------------------------
# GEOAPIFY_PLACES_URL=https://api.geoapify.com/v2/places
# GEOAPIFY_GEOCODE_URL=https://api.geoapify.com/v1/geocode/search

# Seconds to wait on a Geoapify call before giving up.
GEOAPIFY_TIMEOUT_SECONDS=30

# Results per scan. Geoapify caps this per request; raising it is the single
# most effective change if scans feel like they miss businesses.
GEOAPIFY_SEARCH_LIMIT=20

# Search radius around the city centre, in metres.
GEOAPIFY_SEARCH_RADIUS_METRES=5000


# --------------------------------------------------------------------------
# Website scraper
# --------------------------------------------------------------------------
# Seconds to wait for a business website.
SCRAPER_TIMEOUT_SECONDS=20

# Stop reading beyond this many bytes, so one huge page cannot exhaust memory.
SCRAPER_MAX_RESPONSE_BYTES=5242880

# Some sites serve a stripped page or a 403 to non-browser agents.
# SCRAPER_USER_AGENT=Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/126.0.0.0 Safari/537.36


# --------------------------------------------------------------------------
# Pagination
# --------------------------------------------------------------------------
DEFAULT_PAGE_SIZE=20

# Upper bound a client may request via ?pageSize=
MAX_PAGE_SIZE=100


# --------------------------------------------------------------------------
# Logging
# --------------------------------------------------------------------------
# CRITICAL | ERROR | WARNING | INFO | DEBUG
LOG_LEVEL=INFO
# LOG_FORMAT=%(asctime)s %(levelname)-8s %(name)s | %(message)s


# --------------------------------------------------------------------------
# Application metadata
# --------------------------------------------------------------------------
# APP_NAME=Lead Finder API
# APP_VERSION=1.0.0
