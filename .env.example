ENVIRONMENT=development
DEBUG=false
ADMIN_SECRET_KEY=leadfinder_admin_secret_2026_change_in_production
SESSION_TTL_SECONDS=604800
GEOAPIFY_API_KEY=your-geoapify-api-key-here
DATABASE_ECHO=false
DATABASE_POOL_RECYCLE_SECONDS=1800
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
CORS_ALLOW_CREDENTIALS=true
GEOAPIFY_TIMEOUT_SECONDS=30
GEOAPIFY_SEARCH_LIMIT=500
GEOAPIFY_MAX_SCAN_PAGES=20
GEOAPIFY_SEARCH_RADIUS_METRES=5000
SCRAPER_TIMEOUT_SECONDS=20
SCRAPER_MAX_RESPONSE_BYTES=5242880
DEFAULT_PAGE_SIZE=20
MAX_PAGE_SIZE=100
LOG_LEVEL=INFO
LOG_JSON=false
LOG_UVICORN_ACCESS=false
LOG_TRUST_PROXY_HEADERS=false

# Email Provider Configuration (mock | gmail)
EMAIL_PROVIDER=mock
GMAIL_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com
GMAIL_CLIENT_SECRET=your-google-oauth-client-secret
GMAIL_REDIRECT_URI=http://localhost:8000/integrations/gmail/callback
EMAIL_DAILY_QUOTA_LIMIT=400
