# ==========================================================================
# Lead Finder — backend configuration
#
# Copy to `.env` and fill in the values you need:
#
#     cp .env.example .env
#
# `.env` is gitignored and must never be committed — it holds live secrets.
# Every setting below has a default that reproduces current behaviour, so a
# developer only needs GEOAPIFY_API_KEY to get started.
#
# Real environment variables always win over this file, which is how
# containers and CI should supply configuration. To ignore a stray `.env`
# entirely — recommended inside a container image — set:
#
#     LEADFINDER_IGNORE_ENV_FILE=1
#
# This file contains PLACEHOLDERS ONLY. Never paste a real key here: it is
# committed, and everything in it is public to anyone with repository access.
# ==========================================================================


# --------------------------------------------------------------------------
# Environment
# --------------------------------------------------------------------------
# development | testing | production
#
# `production` additionally enforces:
#   - GEOAPIFY_API_KEY must be set
#   - DATABASE_URL must not be SQLite
#   - CORS_ORIGINS must not contain "*"
#   - /docs and /redoc are hidden unless DEBUG=true
ENVIRONMENT=development

# Verbose errors and interactive docs. Never enable in production.
DEBUG=false


# --------------------------------------------------------------------------
# Secrets
#
# Both values below are held as pydantic SecretStr: they are masked in
# repr(settings), in logs, in JSON dumps and in any traceback that prints the
# settings object. Only `settings.geoapify_api_key` and
# `settings.database_url` unwrap them.
# --------------------------------------------------------------------------
# Secret key required for administrative API access.
# Required for /auth/login and Bearer header authentication.
ADMIN_SECRET_KEY=leadfinder_admin_secret_2026_change_in_production

# Geoapify Places + Geocoding key — https://myprojects.geoapify.com/
# Required when ENVIRONMENT=production. Without it, scanning fails with 502.
#
# The literal placeholder below is REJECTED at startup, so a copied-and-
# forgotten .env cannot reach production and fail later as a fake outage.
GEOAPIFY_API_KEY=your-geoapify-api-key-here


# --------------------------------------------------------------------------
# Database
# --------------------------------------------------------------------------
# Defaults to the bundled SQLite file (absolute path, resolved from the
# backend directory). Uncomment the PostgreSQL line for anything real.
#
# Treated as a secret: a PostgreSQL DSN embeds the database password. Logs
# show it with the password masked (postgresql://app:***@db/leadfinder).
# Only sqlite:// and postgresql:// are accepted; anything else fails at
# startup, and the error quotes the scheme only, never the whole URL.
#
# DATABASE_URL=sqlite:///./database/leadfinder.db
# DATABASE_URL=postgresql+psycopg://user:password@localhost:5432/leadfinder

# Log every SQL statement. Noisy; useful when debugging a query.
DATABASE_ECHO=false

# Seconds before a pooled connection is recycled (non-SQLite only).
DATABASE_POOL_RECYCLE_SECONDS=1800


# --------------------------------------------------------------------------
# CORS
# --------------------------------------------------------------------------
# Comma-separated, or a JSON array. Must list the frontend's exact origin —
# "*" is rejected in production.
#
# Each entry must be scheme://host[:port] with no trailing path. A path is
# the commonest mistake: the browser blocks the frontend while the server
# logs look perfectly healthy, so it is rejected at startup instead.
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
CORS_ALLOW_CREDENTIALS=true


# --------------------------------------------------------------------------
# Geoapify tuning
# --------------------------------------------------------------------------
# Must use https when ENVIRONMENT=production: the API key travels as a query
# parameter, so plain HTTP would put it in cleartext on the wire and in every
# proxy log along the way. http is allowed elsewhere for local stubs.
# GEOAPIFY_PLACES_URL=https://api.geoapify.com/v2/places
# GEOAPIFY_GEOCODE_URL=https://api.geoapify.com/v1/geocode/search

# Seconds to wait on a Geoapify call before giving up.
GEOAPIFY_TIMEOUT_SECONDS=30

# Results per scan. Geoapify caps this per request; raising it is the single
# most effective change if scans feel like they miss businesses.
GEOAPIFY_SEARCH_LIMIT=500
# Safety cap for offset-paginated city scans (1-100).
GEOAPIFY_MAX_SCAN_PAGES=20

# Search radius around the city centre, in metres.
GEOAPIFY_SEARCH_RADIUS_METRES=5000


# --------------------------------------------------------------------------
# Website scraper
# --------------------------------------------------------------------------
# Seconds to wait for a business website.
SCRAPER_TIMEOUT_SECONDS=20

# Stop reading beyond this many bytes, so one huge page cannot exhaust memory.
SCRAPER_MAX_RESPONSE_BYTES=5242880

# Some sites serve a stripped page or a 403 to non-browser agents.
# SCRAPER_USER_AGENT=Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/126.0.0.0 Safari/537.36


# --------------------------------------------------------------------------
# Pagination
# --------------------------------------------------------------------------
DEFAULT_PAGE_SIZE=20

# Upper bound a client may request via ?pageSize=
MAX_PAGE_SIZE=100


# --------------------------------------------------------------------------
# Logging
#
# Every record carries: timestamp, level, logger, request id, and — inside a
# request — method, path, status, duration and client IP. Secrets are stripped
# from every line, including tracebacks, as a backstop.
#
# One access line per request:
#   11:39:15 INFO  [505d0b94] access | POST /scan -> 422 in 2.82ms | client_ip=127.0.0.1
# --------------------------------------------------------------------------
# CRITICAL | ERROR | WARNING | INFO | DEBUG
LOG_LEVEL=INFO

# One JSON object per line instead of the human format. Turn this on wherever
# a log shipper is collecting: same records, same fields, machine-readable.
LOG_JSON=false

# The human format string. The request context is appended after it, so a
# custom value here gains those fields rather than losing them.
# LOG_FORMAT=%(asctime)s %(levelname)-8s [%(request_id)s] %(name)s | %(message)s

# Paths whose SUCCESSFUL requests are not access-logged — a health probe every
# two seconds otherwise drowns the file. Failures are always logged.
# LOG_ACCESS_EXCLUDE_PATHS=/health

# Keep uvicorn's own access line as well as ours. Ours says everything it does
# plus the duration, so leaving this on logs every request twice.
LOG_UVICORN_ACCESS=false

# Take the client IP from X-Forwarded-For instead of the socket. Turn this on
# behind a load balancer, where every request otherwise appears to come from
# the balancer — and ONLY there: the header is forgeable unless something
# upstream is guaranteed to overwrite it.
LOG_TRUST_PROXY_HEADERS=false


# --------------------------------------------------------------------------
# Application metadata
# --------------------------------------------------------------------------
# APP_NAME=Lead Finder API
# APP_VERSION=1.0.0
